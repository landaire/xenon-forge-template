# The title's directory as it is copied to the console or opened in Xenia:
# the title as default.xex and the DLL beside it, where the title loads it
# from (`game:\dll.xex`).
filegroup(
    name = "title-directory",
    srcs = {
        "default.xex": "//title:title",
        "dll.xex": "//dll:dll",
    },
)
