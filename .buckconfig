[cells]
  root = .
  prelude = prelude
  toolchains = toolchains
  xbox360 = xenon-forge
  rustc_bootstrap = rustc-bootstrap
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  buck = none

# The Xbox 360 target, the standard library overlay, the toolchain rules and
# xex-link come from xenon-forge at a pinned commit (README, Updating the
# toolchain).
[external_cells]
  prelude = bundled
  xbox360 = git
  rustc_bootstrap = git

[external_cell_xbox360]
  git_origin = https://github.com/landaire/xenon-forge
  commit_hash = ab0cf89128737183db40b25a7765d3d29c1e44ac

[external_cell_rustc_bootstrap]
  git_origin = https://github.com/landaire-contrib/buck2-rustc-bootstrap
  commit_hash = 02ee4260ced11b7d49c71445e10dd660cfebae84

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default \
    target:prelude//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default \
    target:xbox360//...->prelude//platforms:default

[build]
  execution_platforms = xbox360//platforms:execution

[project]
  ignore = .devenv, .direnv, .git, .jj, .tools, buck-out, target
