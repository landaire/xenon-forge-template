load("@prelude//rust:cargo_package.bzl", "DEFAULT_REINDEER_PLATFORMS", "set_reindeer_platforms")

# Targets built for the console use the `xbox360` platform of reindeer.toml.
# The console configuration has no host os or cpu, so the host platforms
# never match it.
set_reindeer_platforms(select({
    "DEFAULT": DEFAULT_REINDEER_PLATFORMS,
    "xbox360//platforms:xbox360": "xbox360",
}))
